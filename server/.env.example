# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/reelo

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT (Phase 1) ────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Caching (Phase 2) ───────────────────────────────────
# Default TTL (seconds) for cache-aside reads
CACHE_DEFAULT_TTL=300

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
