# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Trust X-Forwarded-* headers (set true behind a proxy/load balancer)
TRUST_PROXY=false

# ── MongoDB ─────────────────────────────────────────────
# Multi-document transactions (used by the billing credit flow) require a
# replica set. A standalone mongod still works — the app degrades to
# non-transactional writes — but for full atomicity run a single-node replica
# set: start mongod with `--replSet rs0`, run `rs.initiate()` once, then use:
#   MONGO_URI=mongodb://localhost:27017/reelo?replicaSet=rs0&directConnection=true
MONGO_URI=mongodb://localhost:27017/reelo

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT (Phase 1) ────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Email / Password reset ──────────────────────────────
# Resend — set to send real password-reset emails via resend.com (else the
# stub sender logs the reset link instead of emailing it).
RESEND_API_KEY=
# Sender address; must be from a domain verified in Resend for production.
# EMAIL_FROM=Reelo <onboarding@resend.dev>
# TTL (seconds) for one-time reset tokens and the frontend page the emailed
# link points at (defaults shown):
# PASSWORD_RESET_TTL=900
# PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ── Caching (Phase 2) ───────────────────────────────────
# Default TTL (seconds) for cache-aside reads
CACHE_DEFAULT_TTL=300

# ── Outbound HTTP (social integration adapters) ─────────
# Abort budgets (ms) so a hung upstream can't block a request or the publishing
# scheduler. First is for API/metadata calls; second for video download/upload.
HTTP_CLIENT_TIMEOUT_MS=15000
HTTP_MEDIA_TIMEOUT_MS=120000

# ── Video ───────────────────────────────────────────────
# Shared secret the AI provider presents on the generation callback
GENERATION_CALLBACK_SECRET=dev-generation-callback-secret-change-me

# Video generator selection. Leave VIDEO_PROVIDER unset to auto-detect from the
# credentials below (sora → kling → stub). Set it to force one: sora | kling | stub.
VIDEO_PROVIDER=

# OpenAI Sora — set OPENAI_API_KEY to generate via Sora. Sora returns binary, so
# its output is uploaded to Cloudinary (CLOUDINARY_URL required when using Sora).
OPENAI_API_KEY=
CLOUDINARY_URL=          # cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional tuning (defaults shown):
# SORA_MODEL=sora-2       # sora-2 | sora-2-pro (pro = higher quality, pricier)
# SORA_SIZE=1280x720      # 1280x720 | 720x1280 | 1920x1080 (1080p needs sora-2-pro)
# SORA_BASE_URL=https://api.openai.com/v1
# Optional audio: per-video music (built-in library) + AI narration (OpenAI TTS).
# Upload the music tracks once with `npx tsx scripts/upload-music.ts`.
# TTS_MODEL=gpt-4o-mini-tts

# Kling AI generator — set BOTH keys to generate real videos via Kling's API.
# Leave them blank to use the stub (no real generation). Get keys at
# https://app.klingai.com/global/dev. Results are fetched via poll-on-read.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Optional tuning (defaults shown):
# KLING_BASE_URL=https://api-singapore.klingai.com
# KLING_MODEL=kling-v1
# KLING_MODE=std            # std | pro
# KLING_ASPECT_RATIO=16:9   # 16:9 | 9:16 | 1:1

# ── Connections ─────────────────────────────────────────
# Secret used to derive the AES key for encrypting stored OAuth tokens
CONNECTIONS_ENC_KEY=dev-connections-encryption-key-change-me
# TTL (seconds) for one-time OAuth state tokens
OAUTH_STATE_TTL=600
# Public base URL used to build the OAuth redirect_uri
PUBLIC_BASE_URL=http://localhost:4000
# If set, the OAuth callback 302-redirects here (with ?status=); else returns
# JSON. Point it at the frontend's callback page, e.g.
#   http://localhost:3000/connections/callback
CONNECTIONS_REDIRECT_URL=
# Google OAuth — set BOTH to let users connect a real YouTube channel (else the
# stub provider is used). GOOGLE_CLIENT_ID doubles as the accepted audience for
# "Sign in with Google" ID tokens. Create a "Web application" OAuth client at
# console.cloud.google.com (enable YouTube Data API v3) with the redirect URI
#   <PUBLIC_BASE_URL>/api/v1/connections/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Privacy of videos published to YouTube: private | unlisted | public.
# Unverified Google apps are forced to private by YouTube regardless.
YOUTUBE_PRIVACY_STATUS=private
# Instagram ("Instagram API with Instagram Login") — set BOTH to let users
# connect a real Instagram Professional account and publish Reels (else the
# stub is used). Create a Meta app at developers.facebook.com, add the
# Instagram product, configure Business Login with the redirect URI
#   <PUBLIC_BASE_URL>/api/v1/connections/callback
# Use the Instagram App ID/Secret from the Instagram product page (NOT the
# parent Meta app id/secret).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok (Login Kit + Content Posting API) — set BOTH to let users connect a
# real TikTok account and Direct Post videos (else the stub is used). Create an
# app at developers.tiktok.com, add the Login Kit and Content Posting API
# products, and register the redirect URI
#   <PUBLIC_BASE_URL>/api/v1/connections/callback
# These are the client_key/client_secret (NOT a client_id). Until the app
# passes TikTok's audit, posts are forced to private (SELF_ONLY).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Privacy of videos posted to TikTok:
# SELF_ONLY | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | PUBLIC_TO_EVERYONE.
# Honored only if the creator_info query allows it; pre-audit it stays SELF_ONLY.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ── Publishing ──────────────────────────────────────────
# Shared secret a scheduler/cron presents to run due scheduled publications
PUBLISH_SCHEDULER_SECRET=dev-publish-scheduler-secret-change-me

# ── Agent ───────────────────────────────────────────────
# Conversational assistant that generates and publishes videos through tool
# calls. Set ANTHROPIC_API_KEY to run on the real model; leave it blank and a
# deterministic stub model is used, so the whole chat flow works for free.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5
# Thinking depth / token spend: low | medium | high | xhigh | max
# AGENT_EFFORT=medium
# Thinking and the reply share this budget — leave headroom.
# AGENT_MAX_TOKENS=8192
# Max model <-> tool round trips in a single turn
# AGENT_MAX_ITERATIONS=8
# Trailing slice of history replayed to the model each turn
# AGENT_MAX_HISTORY_MESSAGES=40

# ── Billing ─────────────────────────────────────────────
# Free credits granted to a new account on first use
INITIAL_FREE_CREDITS=100
# Flat credit cost per video generation
VIDEO_CREDIT_COST=10
# Shared secret the stub payment provider presents on the top-up webhook
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret-change-me
# Stripe — set BOTH to take real payments via Stripe Checkout (else the stub is
# used). Get the secret key at dashboard.stripe.com; the webhook secret (whsec_…)
# comes from your webhook endpoint or `stripe listen`. Pack prices live in code
# (server/src/modules/billing/domain/credit-packs.ts): 50=$5, 100=$9, 250=$20.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the buyer after checkout (defaults shown):
# STRIPE_SUCCESS_URL=http://localhost:3000/billing?topup=success
# STRIPE_CANCEL_URL=http://localhost:3000/billing?topup=cancelled

# ── Rate limiting (Phase 3) ─────────────────────────────
# Global per-IP limit: max requests per window (seconds)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
# Stricter tier for auth routes (login/register)
RATE_LIMIT_AUTH_WINDOW=900
RATE_LIMIT_AUTH_MAX=10
# Stricter tier for agent turns (each can spend credits and post)
RATE_LIMIT_AGENT_WINDOW=60
RATE_LIMIT_AGENT_MAX=20

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
