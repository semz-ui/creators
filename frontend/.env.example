# Base URL of the Reelo API (server). Use http://localhost:8080 when running
# behind the nginx load balancer, or http://localhost:4000 for the server directly.
VITE_API_URL=http://localhost:4000

# Google OAuth web client ID (Google Cloud Console → APIs & Services →
# Credentials). Must match the server's GOOGLE_CLIENT_ID. When unset, the
# login/signup pages show a stub "Continue with Google" button that signs in
# as a fixed local identity — pair it with a server whose GOOGLE_CLIENT_ID is
# also unset (stub verifier).
VITE_GOOGLE_CLIENT_ID=
